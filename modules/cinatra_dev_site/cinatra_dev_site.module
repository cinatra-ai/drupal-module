<?php

/**
 * @file
 * Hooks of the Cinatra development site submodule.
 *
 * The profile alter asks the exposure guard first; the import guard (workflow
 * presave) asks only for the development marker.
 */

declare(strict_types=1);

use Drupal\cinatra_dev_site\CinatraDevSite;
use Drupal\cinatra_dev_site\Mcp\ProfileBinding;
use Drupal\cinatra_dev_site\Page\PageMigrator;
use Drupal\cinatra_dev_site\Workflow\EditorialBinder;
use Drupal\content_moderation\Plugin\WorkflowType\ContentModerationInterface;
use Drupal\node\NodeInterface;
use Drupal\workflows\WorkflowInterface;

/**
 * Implements hook_mcp_tools_server_configs_alter().
 *
 * While the exposure is active, it adds the cinatra profile for the current
 * request only when that request carries its own binding, and it counts the
 * read on that binding. An entry already under the cinatra id is foreign:
 * the hook disables an array entry in this altered view, removes any other
 * value, and counts no read. The mcp_tools repository turns every stored
 * entry into an array before it invokes this hook, so a stored entry is
 * disabled; another value under the id can come from an earlier
 * implementation of this hook or from another caller of the alter.
 */
function cinatra_dev_site_mcp_tools_server_configs_alter(array &$servers): void {
  if (!CinatraDevSite::exposureActive()) {
    return;
  }
  $id = CinatraDevSite::PROFILE_ID;
  if (array_key_exists($id, $servers)) {
    if (is_array($servers[$id])) {
      $servers[$id]['enabled'] = FALSE;
    }
    else {
      unset($servers[$id]);
    }
    return;
  }
  $request = \Drupal::requestStack()->getCurrentRequest();
  $binding = $request?->attributes->get(CinatraDevSite::BINDING_ATTRIBUTE);
  if ($binding instanceof ProfileBinding && $binding->request === $request) {
    $servers[$id] = CinatraDevSite::PROFILE;
    $binding->noteRead();
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for workflow entities.
 *
 * The import guard: on a site without the development marker, a syncing
 * save (as a configuration import makes) of a content moderation workflow
 * that binds node:page throws, unless the stored record of that workflow is
 * a content moderation workflow whose node bundle list is an array that
 * names page.
 */
function cinatra_dev_site_workflow_presave(WorkflowInterface $workflow): void {
  if (!$workflow->isSyncing() || CinatraDevSite::markerPresent()) {
    return;
  }
  $plugin = $workflow->getTypePlugin();
  if (!$plugin instanceof ContentModerationInterface || !$plugin->appliesToEntityTypeAndBundle('node', 'page')) {
    return;
  }
  $stored = \Drupal::service('config.storage')->read('workflows.workflow.' . $workflow->id());
  $moderated = is_array($stored) && ($stored['type'] ?? NULL) === 'content_moderation';
  $nodes = $moderated ? ($stored['type_settings']['entity_types']['node'] ?? []) : [];
  if (is_array($nodes) && in_array('page', $nodes, TRUE)) {
    return;
  }
  throw new \RuntimeException(EditorialBinder::IMPORT_GUARD_TEXT);
}

/**
 * Implements hook_node_presave().
 *
 * While the exposure is active, an existing moderated page changes its status
 * only through its moderation state. Core runs this hook before its own
 * moderation hook syncs the status, and a refusal rolls the save back.
 */
function cinatra_dev_site_node_presave(NodeInterface $node): void {
  if (!CinatraDevSite::exposureActive() || $node->bundle() !== 'page' || $node->isNew() || $node->isSyncing()
    || !\Drupal::service('content_moderation.moderation_information')->isModeratedEntity($node)) {
    return;
  }
  $original = method_exists($node, 'getOriginal') ? $node->getOriginal() : ($node->original ?? NULL);
  foreach (array_keys($node->getTranslationLanguages()) as $langcode) {
    if (!$original instanceof NodeInterface || !$original->hasTranslation($langcode)) {
      continue;
    }
    $translation = $node->getTranslation($langcode);
    $before = $original->getTranslation($langcode);
    if ($translation->isPublished() !== $before->isPublished()
      && $translation->get('moderation_state')->value === $before->get('moderation_state')->value) {
      throw new \RuntimeException(PageMigrator::STATUS_REFUSAL_TEXT);
    }
  }
}
