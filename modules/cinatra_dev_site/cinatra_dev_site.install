<?php

/**
 * @file
 * Install requirements and uninstall of the development site submodule.
 *
 * Core loads this file to check a module that is not installed yet, before
 * the module's namespace is registered. So the requirements hook names no
 * class of this module.
 */

declare(strict_types=1);

use Drupal\cinatra_dev_site\DevSiteEnsure;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_requirements().
 *
 * The install needs the development marker CINATRA_DEV_SITE=1.
 */
#[LegacyRequirementsHook]
function cinatra_dev_site_requirements($phase): array {
  if ($phase !== 'install' || getenv('CINATRA_DEV_SITE') === '1') {
    return [];
  }
  return [
    'cinatra_dev_site_marker' => [
      'title' => 'Cinatra development site',
      'description' => 'This module installs only on a site with CINATRA_DEV_SITE=1.',
      // REQUIREMENT_ERROR.
      'severity' => 2,
    ],
  ];
}

/**
 * Implements hook_uninstall().
 *
 * It runs only for an installed module, whose namespace is registered.
 * ModuleInstaller::uninstall() of Drupal core 11.4 calls it after
 * hook_module_preuninstall() and before it removes the module's
 * configuration and its entry in the extension list. release() takes
 * ensure()'s lock: while ensure() holds it, this throws, so the uninstall
 * stops before core removes either.
 */
function cinatra_dev_site_uninstall($is_syncing): void {
  $result = \Drupal::service('cinatra_dev_site.ensure')->release((bool) $is_syncing);
  if (!$result['ok']) {
    throw new \RuntimeException(DevSiteEnsure::BUSY_TEXT);
  }
}
